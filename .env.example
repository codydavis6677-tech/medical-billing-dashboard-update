# ============================================
# DATABASE (PostgreSQL - Supabase, Railway, Neon, AWS RDS, etc.)
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/medical_billing?schema=public"

# ============================================
# NEXTAUTH (Authentication)
# ============================================
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# AI PROVIDER CONFIGURATION (Open-Source First)
# ============================================
# Choose your AI provider: openai | ollama | huggingface | local
AI_PROVIDER="ollama"

# --- OpenAI (Optional) ---
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# --- Ollama (Open-Source, Self-Hosted) ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# --- Hugging Face (Open-Source Models) ---
HUGGINGFACE_API_KEY="your-huggingface-api-key"
HUGGINGFACE_BASE_URL="https://api-inference.huggingface.co/models"
HUGGINGFACE_MODEL="meta-llama/Llama-2-7b-chat-hf"

# --- Local AI (Custom Endpoint) ---
LOCAL_AI_BASE_URL="http://localhost:8000"
LOCAL_AI_MODEL="local-model"

# ============================================
# GOOGLE SHEETS INTEGRATION (Your Existing System)
# ============================================
GOOGLE_SHEETS_API_KEY="your-google-sheets-api-key"
